{
  "schemaVersion": 7,
  "minReaderVersion": 7,
  "provider": "codex",
  "defaultFor": ["codex"],
  "overlay": {
    "version": {
      "parts": {
        "version": true,
        "name": false
      },
      "effect": "chip",
      "size": 14,
      "effectColor": "#001124",
      "backdrop": "none",
      "position": "top-right"
    },
    "effort": {
      "show": true,
      "position": "bottom",
      "size": 7,
      "spacing": 2,
      "color": "#ffffff",
      "effect": "outline",
      "effectColor": "#000000",
      "backdrop": "none",
      "backdropColor": "#000000",
      "backdropStrength": 60
    }
  },
  "avatars": [
    {
      "folder": "Astra",
      "matches": [
        "*-astra*"
      ]
    },
    {
      "folder": "Sol",
      "matches": [
        "*-sol*"
      ]
    },
    {
      "folder": "Terra",
      "matches": [
        "*-terra*"
      ]
    },
    {
      "folder": "Luna",
      "matches": [
        "*-luna*"
      ]
    }
  ]
}
