{
  "schemaVersion": 7,
  "minReaderVersion": 7,
  "provider": "claude",
  "overlay": {
    "version": { "effect": "outline", "size": 16, "textColor": "#ffffff", "effectColor": "#000000", "effectOpacity": 70, "backdrop": "none", "position": "top-right", "parts": { "name": false, "version": true } },
    "effort": { "show": true, "position": "bottom", "size": 7, "spacing": 2, "color": "#ffffff", "effect": "outline", "effectColor": "#000000", "backdrop": "none" }
  },
  "avatars": [
    { "folder": "Fable", "matches": ["*fable*"] },
    { "folder": "Opus", "matches": ["*opus*"] },
    { "folder": "Sonnet", "matches": ["*sonnet*"] },
    { "folder": "Haiku", "matches": ["*haiku*"] }
  ]
}
