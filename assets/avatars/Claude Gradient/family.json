{
  "schemaVersion": 7,
  "minReaderVersion": 7,
  "provider": "claude",
  "overlay": {
    "version": {
      "parts": {
        "version": true,
        "name": false
      },
      "effect": "glow",
      "size": 16,
      "effectColor": "#ff7300",
      "glowStrength": 200,
      "backdrop": "none",
      "position": "top-right"
    },
    "effort": {
      "show": true,
      "position": "bottom",
      "size": 7,
      "spacing": 2,
      "color": "#ffffff",
      "effect": "outline",
      "effectColor": "#000000",
      "backdrop": "none",
      "backdropColor": "#000000",
      "backdropStrength": 60
    }
  },
  "avatars": [
    {
      "folder": "Fable",
      "matches": [
        "*fable*"
      ]
    },
    {
      "folder": "Opus",
      "matches": [
        "*opus*"
      ]
    },
    {
      "folder": "Sonnet",
      "matches": [
        "*sonnet*"
      ]
    },
    {
      "folder": "Haiku",
      "matches": [
        "*haiku*"
      ]
    }
  ]
}
