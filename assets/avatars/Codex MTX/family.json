{
  "schemaVersion": 7,
  "minReaderVersion": 7,
  "provider": "codex",
  "overlay": {
    "version": { "effect": "outline", "size": 16, "textColor": "#ffffff", "effectColor": "#000000", "backdrop": "none", "position": "top-right", "parts": { "name": false, "version": true } },
    "effort": { "show": true, "position": "bottom", "size": 7, "spacing": 2, "color": "#ffffff", "effect": "outline", "effectColor": "#000000", "backdrop": "none", "backdropColor": "#000000", "backdropStrength": 60 }
  },
  "avatars": [
    { "folder": "MTX-Ast", "matches": ["*-astra*"] },
    { "folder": "MTX-Sol", "matches": ["*-sol*"] },
    { "folder": "MTX-Te", "matches": ["*-terra*"] },
    { "folder": "MTX-Lu", "matches": ["*-luna*"] }
  ]
}
