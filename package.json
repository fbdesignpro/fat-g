{
  "name": "fat-g",
  "version": "0.9.1",
  "description": "A game-styled, DOM-based desktop shell for agent CLIs. Not affiliated with Anthropic or OpenAI.",
  "author": "Francois Bertrand",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:setup": "node scripts/dev-setup.mjs",
    "trace:live": "node scripts/trace-live.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:changed": "node scripts/check.mjs lint",
    "test": "npm run test:tooling && vitest run",
    "test:tooling": "node --test \"scripts/**/*.test.mjs\"",
    "test:focused": "node scripts/check.mjs test",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run smoke && npm run smoke:scenario -- all",
    "check:focused": "node scripts/check.mjs focused",
    "check:plan": "node scripts/check.mjs focused --list",
    "smoke": "node scripts/smoke.mjs preview",
    "smoke:dev": "node scripts/smoke.mjs dev",
    "smoke:packaged": "node scripts/smoke.mjs packaged",
    "smoke:scenario": "node scripts/smoke-scenario.mjs",
    "package": "node scripts/package.mjs release",
    "package:dir": "node scripts/package.mjs release --dir",
    "package:smoke": "node scripts/package.mjs smoke"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "minisearch": "7.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "marked": "18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  }
}
